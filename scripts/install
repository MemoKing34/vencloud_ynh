#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

root_redirect="https://github.com/Vencord/Vencloud"
size_limit="32000000"
ynh_app_setting_set --key=root_redirect --value="$root_redirect"
ynh_app_setting_set --key=size_limit --value="$size_limit"

pepper_secrets=$(ynh_string_random --length=64)
pepper_settings=$(ynh_string_random --length=64)
ynh_app_setting_set --key=pepper_secrets --value="$pepper_secrets"
ynh_app_setting_set --key=pepper_settings --value="$pepper_settings"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir/source"
chown -R "$app:$app" "$install_dir"

#=================================================
# BUILD
#=================================================
ynh_script_progression "Building Vencloud (this may take a while)..."

_vencloud_build

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration files..."

_vencloud_add_config

chown -R "$app:$app" "$data_dir"
chmod 750 "$data_dir"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_nginx

_vencloud_add_services

ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICES
#=================================================
ynh_script_progression "Starting $app's systemd services..."

ynh_systemctl --service="$app-redis" --action="start" --log_path="/var/log/$app/redis.log" --wait_until="Ready to accept connections"
ynh_systemctl --service="$app" --action="start"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
